    { "id": "avail", "lane": "external", "col": 2, "type": "external", "label": "服务可用?", "width": 130 },
    { "id": "skip", "lane": "external", "col": 4, "type": "external", "label": "pytest.skip", "width": 130 },
    { "id": "drive", "lane": "backend", "col": 2, "type": "backend", "label": "驱动 get/put", "width": 150 },
