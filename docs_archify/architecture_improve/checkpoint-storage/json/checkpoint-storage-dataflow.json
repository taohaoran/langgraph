    { "from": "checkpoint-record", "to": "pg-store", "label": "写入", "classification": "upsert", "variant": "emphasis" },
    { "from": "checkpoint-record", "to": "serializer", "label": "反序列化", "classification": "字节→对象", "variant": "default", "labelDy": -20 },
    { "from": "pg-store", "to": "restored-state", "label": "恢复", "classification": "重建通道", "variant": "emphasis", "labelDy": 25 }
