  "nodes": [
    { "id": "state-object", "type": "frontend", "label": "图状态对象", "sublabel": "channels 快照", "stage": 0, "row": 0 },
    { "id": "serializer", "type": "backend", "label": "序列化器族", "sublabel": "jsonplus/msgpack/加密", "stage": 1, "row": 0 },
    { "id": "checkpoint-record", "type": "database", "label": "CheckpointTuple", "sublabel": "版本+字节+元数据", "stage": 2, "row": 0 },
    { "id": "pg-store", "type": "database", "label": "Postgres/SQLite", "sublabel": "外部存储", "stage": 3, "row": 0 },
    { "id": "restored-state", "type": "frontend", "label": "恢复状态", "sublabel": "重建通道", "stage": 3, "row": 1 }
