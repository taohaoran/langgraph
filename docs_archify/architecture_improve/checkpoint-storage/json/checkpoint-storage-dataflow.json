  "cards": [
    { "dot": "cyan", "title": "写路径", "items": ["状态对象 → serde 序列化 → checkpoint tuple → 数据库", "每超级步一写；pending writes 支持增量合并", "版本号与 parent 链支撑时间旅行调试"] },
    { "dot": "emerald", "title": "读路径", "items": ["数据库 → 反序列化 → 重建通道状态", "恢复链路：存储 → record → 反序列化 → 状态", "store/cache 提供长期记忆与命中缓存"] }
  ]
