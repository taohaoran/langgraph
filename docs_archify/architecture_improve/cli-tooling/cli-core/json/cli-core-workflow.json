    { "id": "route", "type": "backend", "lane": "entry", "col": 2, "label": "路由命令" },
    { "id": "validate", "type": "backend", "lane": "infra", "col": 3, "label": "校验配置" },
    { "id": "exec", "type": "backend", "lane": "entry", "col": 4, "label": "执行子命令" },
    { "id": "output", "type": "external", "lane": "user", "col": 5, "label": "打印结果" }
