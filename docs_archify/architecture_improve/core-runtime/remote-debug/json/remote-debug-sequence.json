    { "id": "m5", "from": "client", "to": "rg", "y": 345, "label": "映射为 StreamPart/状态", "variant": "return" },
    { "id": "m6", "from": "rg", "to": "user", "y": 390, "label": "返回结果/StateSnapshot", "variant": "return" }
  ],
  "cards": [
    { "dot": "emerald", "title": "要点", "items": [
      "本地代理远端图，协议对齐 Pregel",
