{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "LangGraph 数据与请求流水线（改进版）",
    "output": "system-dataflow.html",
    "quality_profile": "standard",
    "locale": "zh-CN",
    "viewBox": [1180, 640]
  },
  "stages": [
    { "label": "输入与构建" },
    { "label": "图编译与通道" },
    { "label": "执行循环" },
    { "label": "持久化与序列化" },
    { "label": "输出" }
  ],
  "nodes": [
    { "id": "user-input", "type": "frontend", "label": "用户输入", "sublabel": "input + config", "stage": 0, "row": 0 },
    { "id": "stategraph", "type": "backend", "label": "StateGraph 编译", "sublabel": "节点/边/通道", "stage": 1, "row": 0 },
    { "id": "channels-init", "type": "backend", "label": "通道初始化", "sublabel": "从 checkpoint 恢复", "stage": 1, "row": 1 },
    { "id": "pregel-loop", "type": "backend", "label": "PregelLoop", "sublabel": "超级步 tick", "stage": 2, "row": 0 },
    { "id": "node-exec", "type": "backend", "label": "节点并发执行", "sublabel": "PregelRunner", "stage": 2, "row": 1 },
    { "id": "checkpoint-write", "type": "database", "label": "Checkpoint 读写", "sublabel": "Saver 抽象", "stage": 3, "row": 0 },
    { "id": "serde", "type": "database", "label": "序列化器族", "sublabel": "jsonplus/msgpack/加密", "stage": 3, "row": 1 },
    { "id": "store", "type": "database", "label": "Store/Cache", "sublabel": "长期记忆", "stage": 3, "row": 2 },
    { "id": "stream-transform", "type": "messagebus", "label": "流转换器", "sublabel": "StreamTransform", "stage": 4, "row": 0 },
    { "id": "final-state", "type": "frontend", "label": "最终状态/流", "sublabel": "输出给用户", "stage": 4, "row": 1 }
  ],
  "flows": [
    { "from": "user-input", "to": "stategraph", "label": "输入状态", "classification": "TypedDict/Pydantic", "variant": "emphasis" },
    { "from": "stategraph", "to": "channels-init", "label": "通道定义", "classification": "schema", "variant": "default", "labelDy": 25 },
    { "from": "stategraph", "to": "pregel-loop", "label": "编译为 Pregel 图", "classification": "节点+边+通道", "variant": "emphasis" },
    { "from": "pregel-loop", "to": "node-exec", "label": "就绪任务", "classification": "任务调度", "variant": "default", "route": "vertical-channel", "labelDx": -50 },
    { "from": "node-exec", "to": "pregel-loop", "label": "通道写入", "classification": "writes", "variant": "default", "route": "vertical-channel", "labelDx": 40 },
    { "from": "pregel-loop", "to": "checkpoint-write", "label": "每步持久化", "classification": "checkpoint tuple", "variant": "default" },
    { "from": "checkpoint-write", "to": "serde", "label": "序列化/反序列化", "classification": "Serializer 族", "variant": "default", "labelDy": 40 },
    { "from": "pregel-loop", "to": "store", "label": "读写记忆", "classification": "get/put/search", "variant": "dashed" },
    { "from": "pregel-loop", "to": "stream-transform", "label": "流事件", "classification": "values/updates/debug", "variant": "emphasis", "route": "bottom-channel", "labelDy": 12, "labelDx": -110 },
    { "from": "stream-transform", "to": "final-state", "label": "转换后输出", "classification": "SSE/迭代器", "variant": "emphasis", "labelDy": 25 }
  ],
  "cards": [
    { "dot": "cyan", "title": "状态模型", "items": ["Channels 是状态唯一真相源，节点通过读写通道通信", "执行前从 checkpoint 恢复重建 Channels（经 pregel-io）", "BinaryOperatorAggregate 支持累加语义（如 add_messages）"] },
    { "dot": "emerald", "title": "流模式", "items": ["values: 每步完整状态；updates: 节点返回增量", "debug: 完整执行轨迹；messages: 消息级 token 流", "custom: 自定义 StreamTransform 转换器"] },
    { "dot": "amber", "title": "持久化", "items": ["每超级步写入 checkpoint；serde 族负责对象↔字节", "Store/Cache 提供跨线程长期记忆与缓存", "外部数据库与驱动不在本仓库源码内"] }
  ]
}
