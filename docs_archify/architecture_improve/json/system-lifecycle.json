    { "id": "terminal", "label": "中断出口" }
  ],
  "states": [
    { "id": "created", "type": "start", "label": "已创建", "sublabel": "graph.compile", "lane": "main", "col": 0, "tag": "start" },
    { "id": "restoring", "type": "active", "label": "恢复检查点", "sublabel": "PregelLoop.init", "lane": "main", "col": 1, "tag": "restore" },
    { "id": "superstep", "type": "active", "label": "超级步执行", "sublabel": "BSP 循环", "lane": "main", "col": 2, "tag": "running" },
    { "id": "streaming", "type": "active", "label": "流式输出", "sublabel": "stream_mode", "lane": "main", "col": 3, "tag": "output" },
    { "id": "completed", "type": "success", "label": "完成", "sublabel": "返回最终状态", "lane": "main", "col": 4, "tag": "terminal" },
    { "id": "interrupted", "type": "waiting", "label": "中断等待", "sublabel": "interrupt()", "lane": "terminal", "col": 1, "tag": "pause" }
