  "transitions": [
    { "from": "created", "to": "restoring", "variant": "emphasis" },
    { "from": "restoring", "to": "superstep", "variant": "emphasis" },
    { "from": "superstep", "to": "streaming", "variant": "emphasis" },
    { "from": "streaming", "to": "completed", "variant": "emphasis" },
    { "from": "superstep", "to": "interrupted", "variant": "dashed" }
  ],
  "cards": [
    { "dot": "emerald", "title": "主路径", "items": ["编译→恢复→超级步→流式输出→完成", "超级步内 BSP 三阶段循环", "每步末持久化 checkpoint"] },
    { "dot": "amber", "title": "中断与异常", "items": ["interrupt() 在超级步间暂停", "Command 恢复可跳转节点", "节点失败可重试或路由 error_handler"] }
  ]
}
