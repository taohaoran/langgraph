    { "id": "terminal", "label": "失败" }
  ],
  "states": [
    { "id": "queued", "type": "start", "label": "待调度", "lane": "main", "col": 0, "step": "01" },
    { "id": "running", "type": "active", "label": "运行中", "sublabel": "执行节点逻辑", "lane": "main", "col": 1, "step": "02" },
    { "id": "completed", "type": "success", "label": "完成", "sublabel": "节点返回更新", "lane": "main", "col": 2, "step": "03" },
    { "id": "interrupted", "type": "waiting", "label": "已中断", "sublabel": "抛 GraphInterrupt", "lane": "wait", "col": 0, "step": "04" },
    { "id": "failed", "type": "failure", "label": "失败", "lane": "terminal", "col": 0, "step": "05" }
