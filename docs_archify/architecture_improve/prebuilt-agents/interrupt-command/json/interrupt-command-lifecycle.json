  "transitions": [
    { "id": "t1", "from": "queued", "to": "running" },
    { "id": "t2", "from": "running", "to": "completed" },
    { "id": "t3", "from": "running", "to": "interrupted" },
    { "id": "t4", "from": "interrupted", "to": "running", "label": "Command(resume)", "variant": "emphasis" },
    { "id": "t5", "from": "running", "to": "failed" },
    { "id": "t6", "from": "failed", "to": "running", "label": "重试" }
  ],
  "cards": [
    { "dot": "emerald", "title": "恢复语义", "items": [
